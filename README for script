--------------------------------------------------------------

local SCRIPT_LOGS = {
    "[StudioMax] Initializing core systems...",
    "[StudioMax] Loading interface modules...",
    "[StudioMax] Loading Explorer systems...",
    "[StudioMax] Initializing gizmo engine...",
    "[StudioMax] Loading selection systems...",
    "[StudioMax] Preparing mobile interface...",
    "[StudioMax] Preparing PC interface...",
    "[StudioMax] Loading tester profile...",
    "[StudioMax] Checking Studio Max modules...",
    "[StudioMax] Finalizing initialization...",
    "[StudioMax] System ready."
}

local function runLoading()

    local startTime = os.clock()
    local currentLog = 1

    while true do

        local elapsed = os.clock() - startTime
        local progress = math.clamp(elapsed / LOAD_TIME, 0, 1)

        local logIndex = math.clamp(
            math.floor(progress * #SCRIPT_LOGS) + 1,
            1,
            #SCRIPT_LOGS
        )

        if logIndex ~= currentLog then
            currentLog = logIndex
        end

        -- Fast automatic scrolling code display.
        local visibleLogs = {}

        for i = 1, currentLog do
            table.insert(visibleLogs, SCRIPT_LOGS[i])
        end

        codeText.Text = table.concat(visibleLogs, "\n")
        status.Text = SCRIPT_LOGS[currentLog]
        barFill.Size = UDim2.new(progress, 0, 1, 0)
        percent.Text = math.floor(progress * 100) .. "%"

        if progress >= 1 then
            break
        end

        task.wait(0.03)
    end

    codeText.Text = table.concat(SCRIPT_LOGS, "\n")
    barFill.Size = UDim2.new(1, 0, 1, 0)
    percent.Text = "100%"
    status.Text = "[ SYSTEM READY ]"

    task.wait(0.15)

    loadingFrame:Destroy()
end

